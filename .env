# Chép file này thành .env rồi sửa cho đúng máy chủ. Không đưa .env lên git.
# Mọi biến đều có giá trị mặc định trong code; chỉ cần điền những dòng khác mặc định.

# --- Chandra OCR (vLLM, OpenAI-compatible) ---
CHANDRA_MODEL="/home/your_user/.cache/huggingface/hub/models--datalab-to--chandra-ocr-2/snapshots/your_snapshot"
CHANDRA_URL="http://localhost:8101/v1/chat/completions"
SORT_FIRST_PAGES=8                    # số trang đầu đem OCR tìm tên sách
SORT_PDF_DPI=160                      # DPI render PDF
SORT_CHANDRA_WORKERS=4                # số trang OCR song song trong một job
SORT_CHANDRA_MAX_TOKENS=3200          # max_tokens khi OCR trang đầu
SORT_CHANDRA_DATE_MAX_TOKENS=3000     # max_tokens khi OCR cả trang cuối tìm ngày lưu chiểu
SORT_CHANDRA_INFO_MAX_TOKENS=3000     # max_tokens khi OCR trang thông tin xuất bản
SORT_CHANDRA_MAX_SIDE=1800            # cạnh dài tối đa (px) của ảnh gửi Chandra
SORT_CHANDRA_TIMEOUT=600              # giây

# --- Trang cuối ---
SORT_DATE_LAST_PAGES=5                # số trang cuối tối đa tìm dòng "In xong và nộp lưu chiểu"
SORT_INFO_LAST_PAGES=2                # số trang cuối tìm thông tin xuất bản
SORT_BIA_MAX_PAGES=2                  # số trang đầu của PDF bìa đem OCR

# --- Qwen (vLLM) tìm tên sách ---
QWEN_LLM_MODEL="/home/your_user/.cache/huggingface/hub/models--Qwen--Qwen3-4B-Instruct-2507/snapshots/your_snapshot"
QWEN_LLM_URL="http://localhost:8113/v1/chat/completions"
SORT_QWEN_PAGE_CHARS=0                # ký tự tối đa mỗi trang gửi Qwen (0 = không cắt)
SORT_QWEN_MAX_CHARS=0                 # tổng ký tự tối đa gửi Qwen (0 = không cắt)
SORT_QWEN_MAX_TOKENS=500              # max_tokens câu trả lời
SORT_QWEN_TIMEOUT=300                 # giây

# --- ProtonX sửa chính tả ---
SPELLFIX_MODEL="/home/your_user/.cache/huggingface/hub/models--protonx-models--protonx-legal-tc/snapshots/your_snapshot"
SPELLFIX_API_URL="http://localhost:8006/spellfix/correct"
SPELLFIX_GPU=0
SPELLFIX_DTYPE=float16
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- API ---
SORT_WORKERS=4                        # số job chạy cùng lúc trong API
SORT_ALLOWED_ROOTS=""                 # giới hạn thư mục được đọc khi gửi đường dẫn (cách nhau dấu phẩy), trống = không giới hạn
SORT_ALLOW_URL=0                      # 1 = cho gửi file qua URL http(s)
LOG_KEEP_DAYS=30
