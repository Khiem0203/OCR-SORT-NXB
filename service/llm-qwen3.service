[Unit]
Description=vLLM Service for Qwen/Qwen3-4B-Instruct-2507
After=network.target

[Service]
User=your_user
Group=your_user
WorkingDirectory=/home/your_user
Environment="PATH=/home/your_user/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HF_HUB_OFFLINE=1"
ExecStart=/home/your_user/.venv/bin/vllm serve \
    "/home/your_user/.cache/huggingface/hub/models--Qwen--Qwen3-4B-Instruct-2507/snapshots/cdbee75f17c01a7cc42f958dc650907174af0554" \
    --trust-remote-code \
    --port 8113 \
    --max-model-len 10000 \
    --gpu-memory-utilization 0.7 \
    --max-num-batched-tokens 10000 \
    --max-num-seqs 16 \
    --enable-prefix-caching \
    --disable-log-stats
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
